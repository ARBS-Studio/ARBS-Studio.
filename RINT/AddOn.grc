'STR#' ID_ADDON_INFO "Add-on Name and Description" {
/* [  1] */		"ARBS Studio"
/* [  2] */		"ARBS Studio – template i punës në shqip, kompozita, përshkrim teknik, paramasë dhe parallogari, fizikë ndërtimore, insolim, skema dhe plan dinamik sipas legjislacionit të Kosovës."
}

