<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>PARAMASA PËR OFERTIM</title><!--[if gte mso 9]><xml><w:WordDocument><w:View>Print</w:View><w:Zoom>100</w:Zoom></w:WordDocument></xml><![endif]--><style>
  @page { size: A4; margin: 18mm 16mm 18mm 20mm; }
  @page landscape { size: A3 landscape; margin: 12mm; }
  body { font-family: "Segoe UI", Calibri, Arial, sans-serif; font-size: 10.5pt; color: #1d2733; line-height: 1.45; margin: 0; padding: 18px; background: #ffffff; }
  .page-land { page: landscape; }
